# Buildora Backend Production Environment Variables Example
PROJECT_NAME="Buildora Enterprise Field Console"
SECRET_KEY="your_secure_random_jwt_secret_here"
DATABASE_URL="sqlite:////data/buildora.db"
UPLOAD_DIR="/data/uploads/receipt_images"
POLICY_UPLOAD_DIR="/data/uploads/policy_documents"

# AI Integrations
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
TAVILY_API_KEY="your_tavily_api_key_here"

# Vector Database (Optional RAG for Policy Documents)
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="buildora_company_policies"
